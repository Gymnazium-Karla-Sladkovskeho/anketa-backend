# Blackbox test environment — layered on top of the repo-root .env by
# `./gradlew run -Penv=test` (see the dotenv block in build.gradle.kts;
# later files override earlier ones). Also sourced by run.sh for psql.
#
# Dedicated test database — never the dev/prod one. The reset script
# truncates and re-seeds this database without asking.
POSTGRES_DB=gykas_test
# Own port so the test app can run side-by-side with the dev app (8080).
BACKEND_PORT=8081
