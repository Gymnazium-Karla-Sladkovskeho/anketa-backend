  "paths": {
    "/auth": {
      "post": {
        "tags": ["auth"],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  }
                },
                "required": [
                  "email",
                  "password"
                ]
              }
            }
          }
        },
        "summary": "přihlášení",
        "responses": {
          "201": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "access_token": {
                      "type": "string"
                    },
                    "token_type": {
                      "type": "string"
                    },
                    "expires_in": {
                      "type": "number"
                    }
                  }
                },
                "example": {
                  "access_token": "eyJhbGciOiJSUzI1NiJ9",
                  "token_type": "Bearer",
                  "expires_in": 86400
                }
              }
            }
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/auth/me": {
      "get": {
        "tags": ["auth"],
        "summary": "info o přihlášeném uživateli",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "lastname": {
                      "type": "string"
                    },
                    "role": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "name": "Martin",
                  "lastname": "Kořínek",
                  "role": "žák"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/auth/password": {
      "patch": {
        "tags": ["auth"],
        "summary": "změnit mé heslo",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "password": {
                    "type": "string"
                  }
                },
                "required": [
                  "password"
                ]
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "No content",
            "content": { }
          },
          "400": {
            "description": "Bad password (does not meet one or more conditions)"
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
    "/auth/password/{id}": {
      "post": {
        "tags": ["auth"],
        "summary": "restartovat heslo žáka / učitele",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "schema": {
              "type": "number"
            },
            "required": true
          },
          {
            "name": "type",
            "in": "query",
            "schema": {
                "type": "string",
                "enum": [
                  "student",
                  "teacher"
                ]
            },
            "required": true
          }
        ],
        "responses": {
          "201": {
            "description": "OK",
            "content": { 
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "username": {
                      "type": "string"
                    },
                    "password": {
                      "type": "string"
                    }
                  }
                },
                "example": {
                  "username": "petr.pokorny",
                  "password": "eyJhbGciOiJSUzI1NiJ9"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },


